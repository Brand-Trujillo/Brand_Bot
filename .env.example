EVOLUTION_API_URL=https://api.evolution.ai/v1/chat/completions
EVOLUTION_API_KEY=tu_clave_aqui
EVOLUTION_API_MODEL=evolution-1

# Fuente principal: URL remota del Excel de muestras (Google Sheets).
# Si no se define, el sistema usa la URL integrada en datos.py.
ONEDRIVE_XLSX_URL=https://docs.google.com/spreadsheets/d/18IQ-OmkwgfDTUxxfXPOxzcXu-NpAIR2D/edit?usp=drive_link&ouid=116660029921044598774&rtpof=true&sd=true

# Opcional: ruta absoluta al archivo SQLite de muestras (lencdb.db).
# Si se define, tiene prioridad sobre las rutas por defecto.
# También acepta ruta relativa al proyecto (ej. lencdb.db).
DATOS_DB_PATH=
# Respaldo: URL compartida de la base SQLite de muestras (lencdb.db).
# Se usa cuando falla el Excel principal y no hay DB local disponible.
DATOS_DB_URL=https://ainsp.sharepoint.com/:u:/s/TodoNYCE/nycecolombia/IQDYcP46FHm-Tqi8DXyQ5PSpAV_sE58gk4BOLVN5_V_v9y4?email=brandon.trujillo%40nycecolombia.co&e=4ivaex

# Opcional: segundo Excel local para control de equipos.
# Si se define, se une al dataset principal en cada recarga.
EQUIPOS_XLSX_PATH=
# Opcional: URL compartida de OneDrive/SharePoint para el Excel de equipos.
# Si se define, producción lo descargará en cada consulta y no dependerá de redeploy.
EQUIPOS_ONEDRIVE_XLSX_URL=
# Opcional: hoja del Excel de equipos (si no existe, se intenta la primera hoja).
EQUIPOS_SHEET_NAME=CONTROL_EQUIPOS_2026

# Estrategia de refresco de datos del bot:
# strict = recarga el Excel en cada pregunta (maxima frescura)
# fast   = usa microcache en memoria para responder mas rapido
CHATBOT_DATA_REFRESH_MODE=strict
# TTL en segundos para microcache cuando mode=fast.
CHATBOT_DATA_CACHE_TTL_SECONDS=15
# Tono de respuesta: auto | formal | cercano | neutral
CHATBOT_RESPONSE_TONE=auto
# Ruta del log JSONL de calidad (consultas sin resultado o ambiguas).
CHATBOT_METRICS_LOG_PATH=logs/chat_quality.jsonl

# Reintentos de carga para el Excel/DB remota.
DATOS_RETRY_ATTEMPTS=3
DATOS_RETRY_DELAY_MS=700

# Alertas operativas por fallback o caida anomala de filas.
ALERT_MIN_PREV_ROWS=200
ALERT_MIN_ROWS_DROP_RATIO=0.70
ALERT_COOLDOWN_SECONDS=300
DATOS_ALERT_LOG_PATH=logs/data_alerts.jsonl
# Opcional: webhook HTTP POST para alertas (Teams, Make, Zapier, etc.).
ALERT_WEBHOOK_URL=

META_VERIFY_TOKEN=pon_un_token_seguro_aqui
META_ACCESS_TOKEN=tu_meta_access_token
META_PHONE_NUMBER_ID=tu_phone_number_id
META_API_VERSION=v20.0

PORT=5000
